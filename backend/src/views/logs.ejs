<%- include('header') %>
    <div class="header">
        <h2>📜 System Logs</h2>
        <a href="/panel/dashboard">← Back to Dashboard</a>
    </div>

    <div class="card">
        <form action="/panel/logs" method="GET" style="display: flex; gap: 10px; align-items: flex-end;">
            <div class="form-group" style="margin-bottom: 0;">
                <label>Date</label>
                <input type="date" name="date" value="<%= date %>">
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label>Type</label>
                <select name="type">
                    <option value="info" <%=type==='info' ? 'selected' : '' %>>Info Logs</option>
                    <option value="error" <%=type==='error' ? 'selected' : '' %>>Error Logs</option>
                </select>
            </div>
            <button class="btn btn-primary">Filter</button>
        </form>
    </div>

    <div class="card">
        <h3>Log Entries (<%= logs.length %>)</h3>
        <div
            style="max-height: 500px; overflow-y: auto; background: #f8f9fa; border: 1px solid #eee; padding: 10px; border-radius: 4px;">
            <% if (logs.length===0) { %>
                <p style="color: #666; text-align: center; padding: 20px;">No logs found for this date/type.</p>
                <% } else { %>
                    <% logs.forEach(log=> { %>
                        <div class="log-entry">
                            <span style="color: #888; margin-right: 10px;">[<%= log.timestamp %>]</span>
                            <span class="badge badge-<%= type %>">
                                <%= log.level.toUpperCase() %>
                            </span>
                            <span style="margin-left: 10px;">
                                <%= log.message %>
                            </span>
                        </div>
                        <% }) %>
                            <% } %>
        </div>
    </div>
    <%- include('footer') %>