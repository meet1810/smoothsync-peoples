<%- include('header') %>
    <div style="max-width: 400px; margin: 50px auto;">
        <div class="card">
            <h3 style="text-align: center; margin-bottom: 20px;">🔐 Panel Login</h3>
            <% if (error) { %>
                <div class="alert alert-error">
                    <%= error %>
                </div>
                <% } %>
                    <form action="/panel/login" method="POST">
                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" name="email" required placeholder="admin@smoothsync.com">
                        </div>
                        <div class="form-group">
                            <label>Password</label>
                            <input type="password" name="password" required placeholder="******">
                        </div>
                        <button type="submit" class="btn btn-primary" style="width: 100%;">Login to Panel</button>
                    </form>
        </div>
    </div>
    <%- include('footer') %>